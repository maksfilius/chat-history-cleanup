{
  "manifest_version": 3,
  "name": "Chat Cleanup",
  "version": "0.1.0",
  "description": "Safely bulk-archive or delete old ChatGPT conversations, with protection rules and a resumable queue.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
