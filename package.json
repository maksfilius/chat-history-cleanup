{
  "name": "chat-cleanup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:extension && npm run build:landing",
    "build:extension": "node build.mjs",
    "build:landing": "node landing/build.mjs",
    "build:branding": "node scripts/export-branding.mjs",
    "build:store-assets": "node scripts/export-store-assets.mjs",
    "typecheck": "tsc --noEmit",
