{
  "manifest_version": 3,
  "name": "Bulk Delete & Archive ChatGPT Chats — Chat Cleanup",
  "version": "0.2.0",
  "description": "Bulk delete or archive ChatGPT chats safely. Filter by age, review every selection, protect important chats, and resume anytime.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "pageBridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
